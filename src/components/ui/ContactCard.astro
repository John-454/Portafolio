---
import Typography from './Typography.astro';
import Icon from './Icon.astro';
import type { IconName } from '@/utils/icons';

interface Props {
  contact: {
    icon: IconName;
    label: string;
    value: string;
    href: string;
    external?: boolean;
    description: string;
  };
}
const { contact } = Astro.props;
---

<a
  href={contact.href}
  class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition duration-fast hover:-translate-y-0.5 hover:border-brand-300/50 hover:shadow-soft dark:border-slate-700 dark:bg-slate-800 dark:shadow-none dark:hover:border-brand-700/50 dark:hover:shadow-soft-dark"
  target={contact.external ? '_blank' : undefined}
  rel={contact.external ? 'noopener noreferrer' : undefined}
>
  <div
    class="rounded-xl bg-slate-100 p-3 text-brand-600 transition-colors group-hover:bg-brand-100 dark:bg-slate-800 dark:text-brand-400 dark:group-hover:bg-brand-900/30"
  >
    <Icon name={contact.icon} size="md" />
  </div>
  <div class="min-w-0 flex-1">
    <Typography as="p" size="sm" weight="semibold" color="heading" class="truncate"
      >{contact.label}</Typography
    >
    <Typography as="p" size="sm" color="muted" class="truncate font-mono"
      >{contact.value}</Typography
    >
  </div>
  <Typography as="p" size="xs" color="muted" class="hidden whitespace-nowrap sm:block"
    >{contact.description}</Typography
  >
</a>
