---
import { cn } from '@/utils/helpers';
interface Props {
  children?: any;
  class?: string;
  type?: 'default' | 'pill' | 'underline';
  variant?: 'default' | 'muted';
}

const { class: className = '', type = 'default', variant = 'default', ...rest } = Astro.props;
---

<style>
  .tab-trigger {
    @apply font-medium transition-colors duration-fast;
  }
  .tab-trigger[aria-selected='true'] {
    @apply text-brand-600 dark:text-brand-400;
  }
  .tab-trigger[aria-selected='false'] {
    @apply text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200;
  }
  .tab-panel {
    @apply animate-fade-in;
  }
</style>

<div class={cn('flex', type === 'pill' ? 'gap-2' : 'gap-6', className)} role="tablist" {...rest}>
  <slot />
</div>
