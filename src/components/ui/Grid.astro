---
import { cn } from '@/utils/helpers';
interface Props {
  children?: any;
  class?: string;
  columns?: 1 | 2 | 3 | 4 | 5 | 6 | 'auto';
  gap?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  responsive?: boolean;
  /** Atributos HTML adicionales (role, aria-*, data-*). */
  [key: string]: any;
}

const {
  children,
  class: className = '',
  columns = 'auto',
  gap = 'md',
  responsive = true,
  ...rest
} = Astro.props;

const columnClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
  5: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5',
  6: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-6',
  auto: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
};

const gaps = { none: 'gap-0', sm: 'gap-2', md: 'gap-4', lg: 'gap-6', xl: 'gap-8' };
const responsiveClass = responsive ? '' : 'grid-cols-[repeat(auto-fit,minmax(280px,1fr))]';
---

<div class={cn('grid', columnClasses[columns], gaps[gap], responsiveClass, className)} {...rest}>
  <slot>{children}</slot>
</div>
