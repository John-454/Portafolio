---
import { cn } from '@/utils/helpers';
interface Props {
  children?: any;
  class?: string;
  gap?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  direction?: 'row' | 'col';
  align?: 'start' | 'center' | 'end' | 'stretch' | 'baseline';
  justify?: 'start' | 'center' | 'end' | 'between' | 'around' | 'evenly';
  wrap?: boolean;
  fullWidth?: boolean;
  /** Atributos HTML adicionales (role, aria-*, data-*). */
  [key: string]: any;
}

const {
  children,
  class: className = '',
  gap = 'md',
  direction = 'row',
  align = 'stretch',
  justify = 'start',
  wrap = true,
  fullWidth = false,
  ...rest
} = Astro.props;

const gaps = { none: 'gap-0', sm: 'gap-2', md: 'gap-4', lg: 'gap-6', xl: 'gap-8' };
const directions = { row: 'flex-row', col: 'flex-col md:flex-row' };
const aligns = {
  start: 'items-start',
  center: 'items-center',
  end: 'items-end',
  stretch: 'items-stretch',
  baseline: 'items-baseline',
};
const justifies = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
  between: 'justify-between',
  around: 'justify-around',
  evenly: 'justify-evenly',
};
const wrapClass = wrap ? 'flex-wrap' : 'flex-nowrap';
const widthClass = fullWidth ? 'w-full' : '';
---

<div
  class={cn(
    'flex',
    directions[direction],
    aligns[align],
    justifies[justify],
    gaps[gap],
    wrapClass,
    widthClass,
    className
  )}
  {...rest}
>
  <slot>{children}</slot>
</div>
