---
import { cn } from '@/utils/helpers';
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
  quality?: number;
  format?: 'avif' | 'webp' | 'jpg' | 'png';
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  priority = false,
  sizes,
  quality = 80,
  format = 'webp',
  ...rest
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={priority ? 'eager' : loading}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  sizes={sizes}
  class={cn('block max-w-full h-auto', className)}
  {...rest}
/>

<style>
  img {
    @apply transition-opacity duration-300;
  }
  /* Las imágenes nacen VISIBLES: la clase de ocultación sólo la añade el
     script, así que sin JS (o si falla) nunca se pierde contenido. */
  img.img-pending {
    opacity: 0;
  }
  img.img-pending.img-revealed {
    opacity: 1;
  }
</style>

<script>
  document.querySelectorAll('img[loading="lazy"]').forEach((el) => {
    const img = el as HTMLImageElement;
    // Ya descargada: no se oculta (evita el parpadeo de las de caché).
    if (img.complete) return;
    img.classList.add('img-pending');
    // `error` también revela: si la imagen falla debe verse el alt,
    // no un hueco invisible.
    const reveal = () => img.classList.add('img-revealed');
    img.addEventListener('load', reveal, { once: true });
    img.addEventListener('error', reveal, { once: true });
  });
</script>
