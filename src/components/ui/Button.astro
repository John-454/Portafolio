---
import { cn } from '@/utils/helpers';
import Icon from './Icon.astro';
import type { IconName } from '@/utils/icons';
interface Props {
  children?: any;
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'link';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  fullWidth?: boolean;
  external?: boolean;
  icon?: IconName;
  iconPosition?: 'left' | 'right';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  ariaLabel?: string;
  /** Atributos HTML adicionales (data-*). */
  [key: string]: any;
}

const {
  children,
  href,
  variant = 'primary',
  size = 'md',
  disabled = false,
  fullWidth = false,
  external = false,
  icon,
  iconPosition = 'left',
  class: className = '',
  type = 'button',
  ariaLabel,
  ...rest
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center font-medium transition duration-fast ease-smooth focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed';

const variants = {
  primary:
    'bg-brand-600 text-white hover:bg-brand-700 focus-visible:ring-brand-500 dark:bg-brand-500 dark:hover:bg-brand-600 shadow-soft',
  secondary:
    'bg-slate-100 text-slate-900 hover:bg-slate-200 focus-visible:ring-slate-400 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700',
  outline:
    'border-2 border-brand-600 text-brand-600 hover:bg-brand-50 focus-visible:ring-brand-500 dark:border-brand-400 dark:text-brand-400 dark:hover:bg-brand-950',
  ghost:
    'text-slate-700 hover:bg-slate-100 focus-visible:ring-slate-400 dark:text-slate-300 dark:hover:bg-slate-800',
  link: 'text-brand-600 hover:text-brand-700 underline-offset-2 hover:underline focus-visible:ring-brand-500 dark:text-brand-400 dark:hover:text-brand-300',
};

const sizes = {
  // min-h-11: sm/md no bajan de 44px (objetivo táctil de la guía 44×44).
  sm: 'min-h-11 px-3 py-1.5 text-fluid-xs gap-1.5 rounded-lg',
  md: 'min-h-11 px-5 py-2.5 text-fluid-sm gap-2 rounded-xl',
  lg: 'px-7 py-3.5 text-fluid-base gap-2.5 rounded-xl',
};

// Icono proporcionado al texto de cada tamaño (14/16/20px).
const iconSizes = { sm: 'xs', md: 'sm', lg: 'md' } as const;

const widthStyle = fullWidth ? 'w-full' : '';

const isExternal = external || Boolean(href?.startsWith('http'));
const linkAttrs = isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const classes = cn(baseStyles, variants[variant], sizes[size], widthStyle, className);
---

<style>
  .btn {
    @apply relative overflow-hidden;
  }
  .btn:focus-visible {
    @apply ring-2 ring-offset-2 ring-offset-surface-light dark:ring-offset-surface-dark;
  }
</style>

{
  href ? (
    <a
      href={href}
      class={classes}
      aria-disabled={disabled}
      aria-label={ariaLabel}
      {...linkAttrs}
      {...rest}
    >
      {icon && iconPosition === 'left' && <Icon name={icon} size={iconSizes[size]} />}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'right' && <Icon name={icon} size={iconSizes[size]} />}
    </a>
  ) : (
    <button type={type} class={classes} aria-disabled={disabled} aria-label={ariaLabel} {...rest}>
      {icon && iconPosition === 'left' && (
        <Icon name={icon} size={iconSizes[size]} class="flex-shrink-0" />
      )}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'right' && (
        <Icon name={icon} size={iconSizes[size]} class="flex-shrink-0" />
      )}
    </button>
  )
}

<script>
  document.querySelectorAll('a.btn[aria-disabled="true"]').forEach((btn) => {
    btn.addEventListener('click', (e) => e.preventDefault());
  });
</script>
