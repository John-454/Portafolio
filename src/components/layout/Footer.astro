---
import { cn } from '@/utils/helpers';
interface Props {
  class?: string;
}

const { class: className = '', ...rest } = Astro.props;

const socialLinks = [
  { href: 'https://github.com/John-454', label: 'GitHub', icon: 'github' },
  {
    href: 'https://www.linkedin.com/in/john-deivid-chitan-cordoba-17a2b5336',
    label: 'LinkedIn',
    icon: 'linkedin',
  },
  { href: 'mailto:chitancordobajohndeivid@gmail.com', label: 'Email', icon: 'mail' },
];

// Tipado explícito: sin él TS infiere una unión de formas y `external` no
// existe en todos los miembros, fallando en `link.external`.
interface FooterLink {
  href: string;
  label: string;
  external?: boolean;
}

const footerLinks: Record<string, FooterLink[]> = {
  Navegación: [
    // trailingSlash: 'always' → los href llevan la barra final para no
    // provocar un redirect 301 en cada navegación (y coincidir con canonical).
    { href: '/', label: 'Inicio' },
    { href: '/projects/', label: 'Proyectos' },
    { href: '/about/', label: 'Sobre mí' },
    { href: '/experience/', label: 'Experiencia' },
    { href: '/services/', label: 'Servicios' },
    { href: '/contact/', label: 'Contacto' },
  ],
  Recursos: [
    { href: 'https://github.com/John-454', label: 'GitHub', external: true },
    {
      href: 'https://www.linkedin.com/in/john-deivid-chitan-cordoba-17a2b5336',
      label: 'LinkedIn',
      external: true,
    },
    { href: '/cv.pdf', label: 'Descargar CV' },
  ],
  Legal: [
    { href: '/privacy/', label: 'Privacidad' },
    { href: '/terms/', label: 'Términos' },
  ],
};

function getSocialIcon(name: string) {
  const icons: Record<string, string> = {
    github: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>`,
    linkedin: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    mail: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  };
  return icons[name] || icons.github;
}
---

<footer
  class={cn(
    'bg-slate-50 dark:bg-slate-950',
    'border-t border-slate-200/50 dark:border-slate-800/50',
    className
  )}
  {...rest}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a
          href="/"
          class="mb-4 flex items-center gap-2 text-slate-900 dark:text-white"
          aria-label="John Chitan - Inicio"
        >
          <svg
            class="h-8 w-8 text-brand-600 dark:text-brand-400"
            fill="currentColor"
            viewBox="0 0 32 32"
            aria-hidden="true"
          >
            <path
              d="M16 2L4 8v16l12 6 12-6V8L16 2zm0 2.5l9.5 4.75v10.5L16 27.5 6.5 22.75V12.25L16 4.5z"
              stroke="currentColor"
              stroke-width="2"
              fill="none"></path>
            <circle cx="16" cy="16" r="4" fill="currentColor"></circle>
          </svg>
          <span class="font-heading text-xl font-bold">JC</span>
        </a>
        <p class="mb-6 max-w-xs text-fluid-sm text-slate-600 dark:text-slate-400">
          Full Stack Developer especializado en aplicaciones web seguras y escalables. TypeScript,
          Angular, Node.js, GraphQL. Evolucionando hacia AppSec & DevSecOps.
        </p>
        <div class="flex items-center gap-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="rounded-xl border border-slate-200 bg-slate-100 p-2 text-slate-600 transition-all duration-fast hover:border-brand-300 hover:bg-brand-100 hover:text-brand-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:border-brand-700 dark:hover:bg-brand-900/30 dark:hover:text-brand-400"
                aria-label={social.label}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <span set:html={getSocialIcon(social.icon)} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Navigation Columns -->
      {
        Object.entries(footerLinks).map(([title, links]) => (
          <div>
            <h3 class="mb-4 font-heading font-semibold text-slate-900 dark:text-white">{title}</h3>
            <nav aria-label={title}>
              <ul class="space-y-3">
                {links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="rounded text-fluid-sm text-slate-600 transition-colors duration-fast hover:text-brand-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:text-slate-400 dark:hover:text-brand-400"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        ))
      }
    </div>

    <!-- Bottom Bar -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200/50 pt-8 dark:border-slate-800/50 md:flex-row"
    >
      <p class="text-center text-fluid-xs text-slate-500 dark:text-slate-500 md:text-left">
        © {new Date().getFullYear()} John Chitan. Todos los derechos reservados.
      </p>
      <p class="text-center text-fluid-xs text-slate-500 dark:text-slate-500 md:text-right">
        Construido con <span class="text-red-500">♥</span> usando Astro + TypeScript + Tailwind CSS
      </p>
    </div>
  </div>
</footer>
