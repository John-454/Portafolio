---
import { cn } from '@/utils/helpers';
interface Props {
  class?: string;
}

const { class: className = '', ...rest } = Astro.props;

const navLinks = [
  // trailingSlash: 'always' → barra final para no provocar un 301 por clic.
  { href: '/', label: 'Inicio' },
  { href: '/projects/', label: 'Proyectos' },
  { href: '/about/', label: 'Sobre mí' },
  { href: '/experience/', label: 'Experiencia' },
  { href: '/services/', label: 'Servicios' },
  { href: '/contact/', label: 'Contacto' },
];
---

<header
  class={cn(
    'fixed top-0 left-0 right-0 z-50',
    'bg-white/80 dark:bg-slate-950/80 backdrop-blur-xl backdrop-saturate-150',
    'border-b border-slate-200/50 dark:border-slate-800/50',
    'transition-all duration-normal',
    className
  )}
  {...rest}
>
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="Navegación principal">
    <div class="md:h-18 flex h-16 items-center justify-between">
      <!-- Logo/Brand -->
      <a
        href="/"
        class="-ml-2 flex items-center gap-2 rounded-xl px-2 py-1 text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:text-white dark:focus-visible:ring-offset-slate-900"
        aria-label="John Chitan - Inicio"
      >
        <svg
          class="h-8 w-8 text-brand-600 dark:text-brand-400"
          fill="currentColor"
          viewBox="0 0 32 32"
          aria-hidden="true"
        >
          <path
            d="M16 2L4 8v16l12 6 12-6V8L16 2zm0 2.5l9.5 4.75v10.5L16 27.5 6.5 22.75V12.25L16 4.5z"
            stroke="currentColor"
            stroke-width="2"
            fill="none"></path>
          <circle cx="16" cy="16" r="4" fill="currentColor"></circle>
        </svg>
        <span class="hidden font-heading text-xl font-bold sm:block">JC</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-1 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-xl px-4 py-2 text-fluid-sm font-medium text-slate-600 transition-all duration-fast hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white dark:focus-visible:ring-offset-slate-900"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar tema"
          aria-pressed="false"
          class="relative rounded-xl border border-slate-200 bg-slate-100 p-2 text-slate-600 transition-all duration-fast hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-100 dark:focus-visible:ring-offset-slate-900"
        >
          <span class="sr-only">Alternar modo oscuro/claro</span>

          <!-- Sun icon (visible in dark mode) -->
          <svg
            class="sun-icon h-5 w-5 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>

          <!-- Moon icon (visible in light mode) -->
          <svg
            class="moon-icon h-5 w-5 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <a
          href="/contact/"
          class="hidden rounded-xl bg-brand-600 px-5 py-2.5 font-medium text-white transition-all duration-fast hover:bg-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 sm:inline-flex"
        >
          Contactar
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="rounded-xl border border-slate-200 bg-slate-100 p-2 text-slate-600 transition-all duration-fast hover:bg-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700 md:hidden"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden overflow-hidden transition-all duration-300 ease-smooth md:hidden"
      role="navigation"
      aria-label="Menú móvil"
    >
      <div class="space-y-1 border-t border-slate-200/50 py-4 dark:border-slate-800/50">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="block rounded-xl px-4 py-3 text-fluid-sm font-medium text-slate-600 transition-all duration-fast hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
        <div class="border-t border-slate-200/50 pt-4 dark:border-slate-800/50">
          <a
            href="/contact/"
            class="block w-full rounded-xl bg-brand-600 px-5 py-3 text-center font-medium text-white transition-all duration-fast hover:bg-brand-700"
          >
            Contactar
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  #theme-toggle .sun-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: center;
    translate: -50% -50%;
  }

  #theme-toggle .moon-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: center;
    translate: -50% -50%;
  }

  .dark #theme-toggle .sun-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .dark #theme-toggle .moon-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.8);
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!expanded).toString());
      menu.classList.toggle('hidden');
      menu.classList.toggle('block');
    });

    // Close menu on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menu.classList.remove('block');
        btn.setAttribute('aria-expanded', 'false');
      });
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menu.classList.remove('block');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  }

  // Theme Toggle
  const themeBtn = document.getElementById('theme-toggle');
  const html = document.documentElement;

  function updateThemeAriaPressed() {
    if (!themeBtn) return;
    const isDark = html.classList.contains('dark');
    themeBtn.setAttribute('aria-pressed', isDark.toString());
    themeBtn.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
  }

  function toggleTheme() {
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeAriaPressed();
  }

  // Initialize theme from localStorage or system preference
  (function () {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = stored ? stored === 'dark' : prefersDark;
    html.classList.toggle('dark', isDark);
    updateThemeAriaPressed();
  })();

  if (themeBtn) {
    themeBtn.addEventListener('click', toggleTheme);

    // Keyboard support
    themeBtn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleTheme();
      }
    });
  }

  // Sync with system preference changes (only if no user preference stored)
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      html.classList.toggle('dark', e.matches);
      updateThemeAriaPressed();
    }
  });
</script>
