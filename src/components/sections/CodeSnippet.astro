---
const codeSnippet = `// Portfolio Configuration
const portfolio = {
  developer: {
    name: "John Chitan",
    role: "Full Stack Developer",
    focus: ["Secure", "Scalable", "Maintainable"],
    evolving: ["AppSec", "DevSecOps", "Cloud"]
  },
  stack: {
    frontend: ["Angular", "TypeScript", "RxJS", "Tailwind"],
    backend: ["Node.js", "GraphQL", "REST", "Express"],
    database: ["MongoDB", "PostgreSQL", "Redis"],
    devops: ["Docker", "GitHub Actions", "K8s"]
  },
  principles: [
    "Clean Architecture",
    "Type Safety First",
    "Security by Design",
    "Developer Experience"
  ]
};

export default portfolio;`;
---

<div
  class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 shadow-soft-dark"
>
  <div class="flex items-center gap-2 border-b border-slate-800 bg-slate-900 px-4 py-3">
    <div class="h-3 w-3 rounded-full bg-red-500" aria-hidden="true"></div>
    <div class="h-3 w-3 rounded-full bg-yellow-500" aria-hidden="true"></div>
    <div class="h-3 w-3 rounded-full bg-green-500" aria-hidden="true"></div>
    <span class="ml-4 font-mono text-fluid-xs text-slate-400">portfolio.ts</span>
  </div>
  <pre
    class="overflow-x-auto p-4 text-fluid-xs"><code class="language-typescript" style="color: #e2e8f0;" set:html={codeSnippet} /></pre>
</div>
