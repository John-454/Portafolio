---
import Section from '@/components/ui/Section.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { cn } from '@/utils/helpers';
import { skills, skillCategories, type SkillLevel } from '@/data/skills';

// Nivel → etiqueta visible + segmentos llenos de la barra (5 en total).
const levelConfig: Record<SkillLevel, { label: string; segments: number }> = {
  learning: { label: 'Aprendiendo', segments: 1 },
  beginner: { label: 'Principiante', segments: 2 },
  intermediate: { label: 'Intermedio', segments: 3 },
  advanced: { label: 'Avanzado', segments: 4 },
  expert: { label: 'Experto', segments: 5 },
};

const countByCategory = (key: string) => skills.filter((s) => s.category === key).length;

// Dos mitades equilibradas para desktop: se parte en el primer límite de
// categoría que cruza la mitad del total, así nunca se divide una categoría
// y se respeta el orden original (Lenguajes empieza la columna izquierda).
const total = skills.length;
const leftColumn: Array<(typeof skillCategories)[number]> = [];
let acc = 0;
for (const category of skillCategories) {
  leftColumn.push(category);
  acc += countByCategory(category.key);
  if (acc >= total / 2) break;
}
const columns = [
  leftColumn,
  skillCategories.filter((category) => !leftColumn.includes(category)),
].filter((column) => column.length > 0);
---

<Section id="technologies" bg="muted">
  <div class="mb-12 md:mb-16">
    <SectionTitle level={2} icon="code" eyebrow="Stack tecnológico">
      Tecnologías & Herramientas
      <p slot="description">
        Mi stack principal gira en torno a TypeScript end-to-end. Priorizo tipado estricto,
        arquitectura limpia y experiencia de desarrollador. Actualmente expandiendo hacia seguridad
        aplicada e IA.
      </p>
    </SectionTitle>
  </div>

  <!-- Matriz de competencias: una <table> semántica por columna; dos columnas
       en desktop y una sola en móvil. -->
  <div class="grid gap-x-12 gap-y-10 lg:grid-cols-2">
    {
      columns.map((categories) => (
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 dark:border-slate-600">
              <th
                scope="col"
                class="w-full pb-2 pr-4 text-fluid-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
              >
                Tecnología
              </th>
              <th
                scope="col"
                class="pb-2 pr-4 text-fluid-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
              >
                Nivel
              </th>
              <th
                scope="col"
                class="pb-2 text-right text-fluid-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
              >
                Años
              </th>
            </tr>
          </thead>

          {categories.map((category) => {
            const rows = skills.filter((s) => s.category === category.key);
            if (rows.length === 0) return null;

            return (
              <tbody>
                <tr>
                  <th
                    colspan="3"
                    scope="rowgroup"
                    class="pb-2 pt-6 text-left text-fluid-sm font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-400"
                  >
                    {category.label}
                    <span class="ml-2 font-normal text-slate-400 dark:text-slate-500">
                      {rows.length}
                    </span>
                  </th>
                </tr>
                {rows.map((skill) => {
                  const config = levelConfig[skill.level];
                  return (
                    <tr class="border-b border-slate-200/70 transition-colors duration-fast hover:bg-white dark:border-slate-700/70 dark:hover:bg-slate-800/60">
                      <td
                        class="py-2.5 pr-4 text-fluid-sm font-medium text-slate-900 dark:text-white"
                        title={skill.description}
                      >
                        {skill.name}
                      </td>
                      <td class="whitespace-nowrap py-2.5 pr-4 align-middle">
                        <span class="flex items-center gap-2">
                          {/* Barra decorativa: el texto del nivel es lo que
                              portan lectores de pantalla (la barra se oculta
                              en móvil para no estrechar la columna de nombre). */}
                          <span class="hidden gap-1 sm:flex" aria-hidden="true">
                            {[...Array(5)].map((_, i) => (
                              <span
                                class={cn(
                                  'h-1.5 w-2.5 rounded-full',
                                  i < config.segments
                                    ? 'bg-brand-500 dark:bg-brand-400'
                                    : 'bg-slate-300 dark:bg-slate-600'
                                )}
                              />
                            ))}
                          </span>
                          <span class="text-fluid-xs text-slate-600 dark:text-slate-400">
                            {config.label}
                          </span>
                        </span>
                      </td>
                      <td class="whitespace-nowrap py-2.5 text-right align-middle text-fluid-xs tabular-nums text-slate-500 dark:text-slate-400">
                        {skill.years ?? '—'}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            );
          })}
        </table>
      ))
    }
  </div>
</Section>
