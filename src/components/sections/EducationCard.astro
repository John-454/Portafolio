---
import Card from '@/components/ui/Card.astro';
import Flex from '@/components/ui/Flex.astro';
import Typography from '@/components/ui/Typography.astro';
import Badge from '@/components/ui/Badge.astro';
import { formatDateRange } from '@/utils/helpers';

interface Props {
  edu: {
    id: string;
    type: string;
    title: string;
    organization: string;
    startDate: string;
    endDate?: string;
    current: boolean;
    description: string;
    technologies?: string[];
  };
  index: number;
  /** Nivel del título de la tarjeta: 4 bajo un h3 de sub-sección, 3 bajo un h2 de página. */
  level?: 3 | 4;
}
const { edu, level = 4 } = Astro.props;
---

<article class="relative" role="listitem">
  <div
    class="absolute bottom-0 left-4 top-0 w-0.5 bg-slate-200 dark:bg-slate-700"
    aria-hidden="true"
  >
  </div>
  <div class="relative pl-12">
    <div
      class="absolute left-0 top-1 h-3 w-3 rounded-full border-4 border-white bg-brand-500 shadow-soft dark:border-slate-900"
      aria-hidden="true"
    >
    </div>
    <Card
      padded
      class="relative hover:border-brand-300/50 hover:shadow-soft dark:hover:border-brand-700/50 dark:hover:shadow-soft-dark"
    >
      <Flex gap="md" wrap class="mb-2" align="start">
        <div class="min-w-0 flex-1">
          <Typography
            as={level === 3 ? 'h3' : 'h4'}
            size="base"
            weight="semibold"
            color="heading"
            class="truncate">{edu.title}</Typography
          >
          <Typography as="p" size="sm" color="muted" class="mt-0.5">{edu.organization}</Typography>
        </div>
        <div
          class="flex items-center gap-2 whitespace-nowrap text-fluid-sm text-slate-500 dark:text-slate-400"
        >
          <span class="font-mono">{formatDateRange(edu.startDate, edu.endDate, edu.current)}</span>
          {edu.current && <Badge variant="info" label="En curso" size="sm" />}
        </div>
      </Flex>

      <Typography as="p" size="sm" color="muted" class="mb-3">{edu.description}</Typography>

      {
        edu.technologies && edu.technologies.length > 0 && (
          <Flex gap="sm" wrap role="list" aria-label="Tecnologías aprendidas">
            {edu.technologies.map((tech) => (
              <Badge variant="tech" label={tech} size="sm" />
            ))}
          </Flex>
        )
      }
    </Card>
  </div>
</article>
