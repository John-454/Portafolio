---
import Section from '@/components/ui/Section.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Card from '@/components/ui/Card.astro';
import Typography from '@/components/ui/Typography.astro';
import Button from '@/components/ui/Button.astro';
import Flex from '@/components/ui/Flex.astro';
import Input from '@/components/ui/Input.astro';
import ContactCard from '@/components/ui/ContactCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { personalInfo } from '@/data/personal';

// Endpoint de Formspree configurable con PUBLIC_FORMSPREE_ENDPOINT (ver
// .env.example). El literal es el fallback para que el <form> exista aunque
// no haya variables de entorno definidas.
const formspreeEndpoint =
  import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/your-form-id';

interface Props {
  /** Nivel del título: 1 cuando la sección abre su propia página (h1), 2 en el home. */
  titleLevel?: 1 | 2;
}

const { titleLevel = 2 } = Astro.props;
---

<Section id="contact" bg="muted">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <!-- Left: Info -->
    <div class="space-y-8">
      <SectionTitle level={titleLevel} icon="message-circle" eyebrow="Hablemos">
        Contacto
        <p slot="description">
          ¿Tienes un proyecto en mente? ¿Necesitas ayuda con arquitectura, seguridad o
          automatización? Escríbeme y concertamos una llamada sin compromiso.
        </p>
      </SectionTitle>

      <!-- Contact Methods -->
      <div class="space-y-4">
        {
          [
            {
              icon: 'mail' as const,
              label: 'Email',
              value: personalInfo.email,
              href: `mailto:${personalInfo.email}`,
              description: 'Respuesta en 24-48h laborables',
            },
            {
              icon: 'linkedin' as const,
              label: 'LinkedIn',
              value: 'linkedin.com/in/john-deivid-chitan-cordoba',
              href: personalInfo.linkedin,
              external: true,
              description: 'Conectemos profesionalmente',
            },
            {
              icon: 'github' as const,
              label: 'GitHub',
              value: 'github.com/John-454',
              href: personalInfo.github,
              external: true,
              description: 'Código abierto y proyectos',
            },
          ].map((contact) => {
            return <ContactCard contact={contact} />;
          })
        }
      </div>

      <!-- Availability -->
      <Card
        padded
        class="border-brand-200/50 bg-brand-50 dark:border-brand-800/50 dark:bg-brand-950/30"
      >
        <Flex gap="md" align="center" class="mb-3">
          <div
            class="rounded-lg bg-brand-100 p-2 text-brand-600 dark:bg-brand-900/50 dark:text-brand-400"
            aria-hidden="true"
          >
            <Icon name="clock" />
          </div>
          <Typography as={titleLevel === 1 ? 'h2' : 'h3'} weight="semibold" color="heading"
            >Disponibilidad</Typography
          >
        </Flex>
        <Typography as="p" color="muted">
          {personalInfo.availability}. Abierto a oportunidades de tiempo completo, contratos
          freelance y consultoría técnica.
        </Typography>
      </Card>
    </div>

    <!-- Right: Form -->
    <div>
      <Card padded class="sticky top-24">
        <Typography
          as={titleLevel === 1 ? 'h2' : 'h3'}
          size="xl"
          weight="semibold"
          color="heading"
          class="mb-2">Enviar mensaje</Typography
        >
        <Typography as="p" size="sm" color="muted" class="mb-6"
          >Te responderé lo antes posible.</Typography
        >

        <form
          id="contact-form"
          action={formspreeEndpoint}
          method="POST"
          class="space-y-4"
          novalidate
        >
          <Input
            label="Nombre"
            id="name"
            name="name"
            type="text"
            required
            placeholder="Ana Gómez"
            autocomplete="name"
            spellcheck="false"
          />

          <Input
            label="Email"
            id="email"
            name="email"
            type="email"
            required
            placeholder="tu@email.com"
            autocomplete="email"
            spellcheck="false"
          />

          <Input
            label="Asunto"
            id="subject"
            name="subject"
            type="text"
            required
            placeholder="¿De qué se trata?"
          />

          <Input
            label="Mensaje"
            id="message"
            name="message"
            type="textarea"
            required
            placeholder="Cuéntame sobre tu proyecto, necesidades o consulta…"
            rows={5}
          />

          <input
            type="hidden"
            name="_gotcha"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <Button
            type="submit"
            variant="primary"
            fullWidth
            size="lg"
            icon="send"
            iconPosition="left"
          >
            Enviar mensaje
          </Button>

          <p class="text-center text-fluid-xs text-slate-500 dark:text-slate-400">
            Al enviar, aceptas que tus datos se usen solo para responder tu consulta. Ver <a
              href="/privacy/"
              class="underline hover:text-brand-600 dark:hover:text-brand-400">privacidad</a
            >.
          </p>
        </form>

        <div id="form-status" class="mt-4 hidden rounded-xl p-4" role="alert" aria-live="polite">
        </div>
      </Card>
    </div>
  </div>
</Section>

<script>
  // Envío a Formspree + validación inline propia. El `novalidate` del form
  // desactiva la validación nativa: aquí la reemplazamos por errores junto
  // al campo (role="alert" + aria-describedby), foco al primer error al
  // enviar, revalidación al escribir y chequeo de formato al salir del campo.
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');
    if (!form || !status) return;

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    // Cada error dice qué falta y cómo corregirlo, en tono del sitio.
    const validators: Record<string, (value: string) => string> = {
      name: (value) => (value.trim() ? '' : 'Escribe tu nombre para que sepa cómo llamarte.'),
      email: (value) => {
        if (!value.trim()) return 'Necesito tu email para poder responderte.';
        return EMAIL_RE.test(value.trim())
          ? ''
          : 'Revisa el formato: debería ser algo como tu@email.com.';
      },
      subject: (value) => (value.trim() ? '' : 'Añade un asunto para orientar tu mensaje.'),
      message: (value) => {
        if (!value.trim()) return 'Cuéntame en qué puedo ayudarte.';
        return value.trim().length >= 10 ? '' : 'Cuéntame un poco más (mínimo 10 caracteres).';
      },
    };

    const fields = Object.keys(validators)
      .map((id) => form.elements.namedItem(id))
      .filter((el): el is HTMLInputElement | HTMLTextAreaElement => el instanceof HTMLElement);

    function setFieldError(field: HTMLInputElement | HTMLTextAreaElement, message: string) {
      const errorId = `${field.id}-error`;
      if (!message) {
        document.getElementById(errorId)?.remove();
        field.removeAttribute('aria-invalid');
        if (field.getAttribute('aria-describedby') === errorId) {
          field.removeAttribute('aria-describedby');
        }
        return;
      }
      let box = document.getElementById(errorId) as HTMLParagraphElement | null;
      if (!box) {
        box = document.createElement('p');
        box.id = errorId;
        box.setAttribute('role', 'alert');
        box.className =
          'mt-1.5 flex items-center gap-1 text-fluid-xs text-red-500 dark:text-red-400';
        box.innerHTML =
          '<svg class="h-3.5 w-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg><span></span>';
        field.parentElement?.appendChild(box);
      }
      const text = box.querySelector('span');
      if (text) text.textContent = message;
      field.setAttribute('aria-invalid', 'true');
      field.setAttribute('aria-describedby', errorId);
    }

    function validateField(field: HTMLInputElement | HTMLTextAreaElement) {
      const validate = validators[field.id];
      if (!validate) return true;
      const message = validate(field.value);
      setFieldError(field, message);
      return !message;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // 1) Validar todo antes de enviar y llevar el foco al primer error.
      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
      for (const field of fields) {
        if (!validateField(field) && !firstInvalid) firstInvalid = field;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      // Se guarda el HTML (icono + etiqueta): con `textContent` el icono de
      // envío se perdería al restaurar. Spinner sólo durante la petición.
      const originalHTML = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      submitBtn.innerHTML =
        '<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12a9 9 0 11-6.219-8.56" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg><span>Enviando…</span>';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          fields.forEach((field) => setFieldError(field, ''));
          status.className =
            'block p-4 rounded-xl bg-accent-100 dark:bg-accent-900/30 border border-accent-300 dark:border-accent-700 text-accent-800 dark:text-accent-400';
          status.textContent = '¡Mensaje enviado! Te responderé pronto.';
          form.reset();
        } else {
          throw new Error('Error al enviar');
        }
      } catch {
        status.className =
          'block p-4 rounded-xl bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-700 text-red-800 dark:text-red-400';
        status.textContent =
          'Hubo un error. Inténtalo de nuevo o escríbeme directamente por email.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
        submitBtn.innerHTML = originalHTML;
      }
    });

    // 2) Tras el primer intento, corregir sobre la marcha: al escribir sólo
    //    en campos ya marcados (no molestar a quien todavía no envió nada).
    form.addEventListener('input', (e) => {
      const target = e.target;
      if (
        (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) &&
        target.getAttribute('aria-invalid') === 'true'
      ) {
        validateField(target);
      }
    });

    // 3) Al salir de un campo con contenido, chequear formato (p. ej. email)
    //    sin mostrar errores en campos vacías que el usuario ni ha tocado.
    form.addEventListener('focusout', (e) => {
      const target = e.target;
      if (
        (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) &&
        target.value.trim()
      ) {
        validateField(target);
      }
    });
  });
</script>
