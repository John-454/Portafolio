---
import Section from '@/components/ui/Section.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Card from '@/components/ui/Card.astro';
import Typography from '@/components/ui/Typography.astro';
import Button from '@/components/ui/Button.astro';
import Flex from '@/components/ui/Flex.astro';
import Input from '@/components/ui/Input.astro';
import ContactCard from '@/components/ui/ContactCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { personalInfo } from '@/data/personal';

// Endpoint de Formspree configurable con PUBLIC_FORMSPREE_ENDPOINT (ver
// .env.example). El literal es el fallback para que el <form> exista aunque
// no haya variables de entorno definidas.
const formspreeEndpoint =
  import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/your-form-id';
---

<Section id="contact" bg="muted">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <!-- Left: Info -->
    <div class="space-y-8">
      <SectionTitle level={2} icon="message-circle" eyebrow="Hablemos">
        Contacto
        <p slot="description">
          ¿Tienes un proyecto en mente? ¿Necesitas ayuda con arquitectura, seguridad o
          automatización? Escríbeme y concertamos una llamada sin compromiso.
        </p>
      </SectionTitle>

      <!-- Contact Methods -->
      <div class="space-y-4">
        {
          [
            {
              icon: 'mail' as const,
              label: 'Email',
              value: personalInfo.email,
              href: `mailto:${personalInfo.email}`,
              description: 'Respuesta en 24-48h laborables',
            },
            {
              icon: 'linkedin' as const,
              label: 'LinkedIn',
              value: 'linkedin.com/in/john-deivid-chitan-cordoba',
              href: personalInfo.linkedin,
              external: true,
              description: 'Conectemos profesionalmente',
            },
            {
              icon: 'github' as const,
              label: 'GitHub',
              value: 'github.com/John-454',
              href: personalInfo.github,
              external: true,
              description: 'Código abierto y proyectos',
            },
          ].map((contact) => {
            return <ContactCard contact={contact} />;
          })
        }
      </div>

      <!-- Availability -->
      <Card
        padded
        class="border-brand-200/50 bg-brand-50 dark:border-brand-800/50 dark:bg-brand-950/30"
      >
        <Flex gap="md" align="center" class="mb-3">
          <div
            class="rounded-lg bg-brand-100 p-2 text-brand-600 dark:bg-brand-900/50 dark:text-brand-400"
            aria-hidden="true"
          >
            <Icon name="clock" />
          </div>
          <Typography as="h4" weight="semibold" color="heading">Disponibilidad</Typography>
        </Flex>
        <Typography as="p" color="muted">
          {personalInfo.availability}. Abierto a oportunidades de tiempo completo, contratos
          freelance y consultoría técnica.
        </Typography>
      </Card>
    </div>

    <!-- Right: Form -->
    <div>
      <Card padded class="sticky top-24">
        <Typography as="h3" size="xl" weight="semibold" color="heading" class="mb-2"
          >Enviar mensaje</Typography
        >
        <Typography as="p" size="sm" color="muted" class="mb-6"
          >Te responderé lo antes posible.</Typography
        >

        <form
          id="contact-form"
          action={formspreeEndpoint}
          method="POST"
          class="space-y-4"
          novalidate
        >
          <Input
            label="Nombre"
            id="name"
            name="name"
            type="text"
            required
            placeholder="Tu nombre"
            autocomplete="name"
          />

          <Input
            label="Email"
            id="email"
            name="email"
            type="email"
            required
            placeholder="tu@email.com"
            autocomplete="email"
          />

          <Input
            label="Asunto"
            id="subject"
            name="subject"
            type="text"
            required
            placeholder="¿De qué se trata?"
          />

          <Input
            label="Mensaje"
            id="message"
            name="message"
            type="textarea"
            required
            placeholder="Cuéntame sobre tu proyecto, necesidades o consulta..."
            rows={5}
          />

          <input
            type="hidden"
            name="_gotcha"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <Button
            type="submit"
            variant="primary"
            fullWidth
            size="lg"
            icon="send"
            iconPosition="left"
          >
            Enviar mensaje
          </Button>

          <p class="text-center text-fluid-xs text-slate-500 dark:text-slate-400">
            Al enviar, aceptas que tus datos se usen solo para responder tu consulta. Ver <a
              href="/privacy/"
              class="underline hover:text-brand-600 dark:hover:text-brand-400">privacidad</a
            >.
          </p>
        </form>

        <div id="form-status" class="mt-4 hidden rounded-xl p-4" role="alert" aria-live="polite">
        </div>
      </Card>
    </div>
  </div>
</Section>

<script>
  // Form handling with Formspree
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');

    if (form && status) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalText = submitBtn.textContent;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            status.className =
              'block p-4 rounded-xl bg-accent-100 dark:bg-accent-900/30 border border-accent-300 dark:border-accent-700 text-accent-800 dark:text-accent-400';
            status.textContent = '¡Mensaje enviado! Te responderé pronto.';
            form.reset();
          } else {
            throw new Error('Error al enviar');
          }
        } catch {
          status.className =
            'block p-4 rounded-xl bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-700 text-red-800 dark:text-red-400';
          status.textContent =
            'Hubo un error. Inténtalo de nuevo o escríbeme directamente por email.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    }
  });
</script>
