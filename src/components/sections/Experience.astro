---
import Section from '@/components/ui/Section.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Stack from '@/components/ui/Stack.astro';
import Flex from '@/components/ui/Flex.astro';
import Typography from '@/components/ui/Typography.astro';
import Badge from '@/components/ui/Badge.astro';
import ExperienceCard from './ExperienceCard.astro';
import EducationCard from './EducationCard.astro';
import { experience, education, certifications } from '@/data/experience';
---

<Section id="experience" bg="surface">
  <div class="mb-12 md:mb-16">
    <SectionTitle level={2} icon="briefcase" eyebrow="Trayectoria">
      Experiencia Profesional
      <p slot="description">
        Mi trayectoria combina desarrollo de software práctico con experiencia docente. Cada rol ha
        reforzado mi capacidad para comunicar conceptos técnicos complejos y construir soluciones
        reales.
      </p>
    </SectionTitle>
  </div>

  <!-- Professional Experience -->
  <div class="mb-16">
    <Typography
      as="h3"
      size="xl"
      weight="semibold"
      color="heading"
      class="mb-6 flex items-center gap-2"
    >
      <span class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800" aria-hidden="true">
        <svg
          class="h-5 w-5 text-slate-600 dark:text-slate-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg
        >
      </span>
      Experiencia Profesional
    </Typography>

    <Stack space="lg" role="list" aria-label="Experiencia profesional">
      {
        experience.map((exp, index) => {
          return <ExperienceCard exp={exp} index={index} />;
        })
      }
    </Stack>
  </div>

  <!-- Education -->
  <div class="mb-16">
    <Typography
      as="h3"
      size="xl"
      weight="semibold"
      color="heading"
      class="mb-6 flex items-center gap-2"
    >
      <span class="rounded-lg bg-brand-100 p-2 dark:bg-brand-900/30" aria-hidden="true">
        <svg
          class="h-5 w-5 text-brand-600 dark:text-brand-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
          ></path></svg
        >
      </span>
      Formación
    </Typography>

    <Stack space="md" role="list" aria-label="Formación académica">
      {
        education.map((edu, index) => {
          return <EducationCard edu={edu} index={index} />;
        })
      }
    </Stack>
  </div>

  <!-- Certifications -->
  {
    certifications.length > 0 && (
      <div>
        <Typography
          as="h3"
          size="xl"
          weight="semibold"
          color="heading"
          class="mb-6 flex items-center gap-2"
        >
          <span class="rounded-lg bg-accent-100 p-2 dark:bg-accent-900/30" aria-hidden="true">
            <svg
              class="h-5 w-5 text-accent-600 dark:text-accent-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              />
            </svg>
          </span>
          Certificaciones & Cursos
        </Typography>

        <Flex gap="md" wrap role="list" aria-label="Certificaciones">
          {certifications.map((cert) => (
            <Badge
              variant="info"
              label={cert.title}
              size="md"
              class="cursor-help"
              title={cert.description}
            />
          ))}
        </Flex>
      </div>
    )
  }
</Section>
