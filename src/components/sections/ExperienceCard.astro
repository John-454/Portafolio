---
import Card from '@/components/ui/Card.astro';
import Flex from '@/components/ui/Flex.astro';
import Typography from '@/components/ui/Typography.astro';
import Badge from '@/components/ui/Badge.astro';
import { formatDateRange } from '@/utils/helpers';

interface Props {
  exp: {
    id: string;
    type: string;
    title: string;
    organization: string;
    location?: string;
    startDate: string;
    endDate?: string;
    current: boolean;
    description: string;
    responsibilities: string[];
    achievements?: string[];
    technologies?: string[];
    url?: string;
  };
  index: number;
}
const { exp } = Astro.props;
---

<article class="relative" role="listitem">
  <div
    class="absolute bottom-0 left-4 top-0 w-0.5 bg-slate-200 dark:bg-slate-700"
    aria-hidden="true"
  >
  </div>
  <div class="relative pl-12">
    <div
      class="absolute left-0 top-1 h-3 w-3 rounded-full border-4 border-white bg-brand-500 shadow-soft dark:border-slate-900"
      aria-hidden="true"
    >
    </div>
    <Card
      padded
      class="relative hover:border-brand-300/50 hover:shadow-soft dark:hover:border-brand-700/50 dark:hover:shadow-soft-dark"
    >
      <Flex gap="md" wrap class="mb-3" align="start">
        <div class="min-w-0 flex-1">
          <Typography as="h4" size="lg" weight="semibold" color="heading" class="truncate"
            >{exp.title}</Typography
          >
          <Typography as="p" size="sm" color="muted" class="mt-0.5"
            >{exp.organization}{exp.location && ` · ${exp.location}`}</Typography
          >
        </div>
        <div
          class="flex items-center gap-2 whitespace-nowrap text-fluid-sm text-slate-500 dark:text-slate-400"
        >
          <span class="font-mono">{formatDateRange(exp.startDate, exp.endDate, exp.current)}</span>
          {exp.current && <Badge variant="info" label="Actual" size="sm" />}
        </div>
      </Flex>

      <Typography as="p" color="muted" class="mb-4">{exp.description}</Typography>

      {
        exp.responsibilities.length > 0 && (
          <div class="mb-4">
            <Typography as="h5" size="sm" weight="semibold" color="heading" class="mb-2">
              Responsabilidades clave
            </Typography>
            <ul class="space-y-1.5" role="list">
              {exp.responsibilities.map((resp) => (
                <li class="flex items-start gap-2 text-fluid-sm text-slate-600 dark:text-slate-300">
                  <svg
                    class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {resp}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        exp.achievements && exp.achievements.length > 0 && (
          <div class="mb-4">
            <Typography as="h5" size="sm" weight="semibold" color="heading" class="mb-2">
              Logros destacados
            </Typography>
            <ul class="space-y-1.5" role="list">
              {exp.achievements.map((achievement) => (
                <li class="flex items-start gap-2 text-fluid-sm text-slate-600 dark:text-slate-300">
                  <svg
                    class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  {achievement}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        exp.technologies && exp.technologies.length > 0 && (
          <Flex gap="sm" wrap role="list" aria-label="Tecnologías utilizadas">
            {exp.technologies.map((tech) => (
              <Badge variant="tech" label={tech} size="sm" />
            ))}
          </Flex>
        )
      }

      {
        exp.url && (
          <div class="mt-4 border-t border-slate-200 pt-4 dark:border-slate-700">
            <a
              href={exp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 text-fluid-sm text-brand-600 hover:underline dark:text-brand-400"
            >
              Ver detalles
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
          </div>
        )
      }
    </Card>
  </div>
</article>
