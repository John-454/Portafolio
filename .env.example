# Copia este archivo a `.env` (ignorado por git) y ajusta los valores.
# Sólo se exponen las variables `PUBLIC_*`: nunca pongas secretos en ellas.

# URL base que alimenta canonical/OG/sitemap (astro.config.mjs → `site`).
# Si se deja vacía se usa el dominio de producción.
PUBLIC_SITE_URL=https://johnchitan.dev

# Endpoint del formulario de contacto (https://formspree.io).
# ⚠️ Sustituye `<id>` por el ID real de TU formulario: aparece en la URL
# https://formspree.io/f/<id> tras registrarte.
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/<id>
